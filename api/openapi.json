{
  "openapi": "3.0.3",
  "info": {
    "title": "AgriTwin Platform API",
    "version": "0.3.0",
    "description": "Implemented JSON endpoints for the AgriTwin local operational platform. Examples use sample station data or explicitly labelled live/fallback weather sources and never expose secrets."
  },
  "servers": [
    { "url": "/agritwin", "description": "Local AgriTwin base path" }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Application health",
        "responses": { "200": { "description": "Application status", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthStatus" } } } } }
      }
    },
    "/api/openagri/services": {
      "get": {
        "summary": "OpenAgri service health and provenance",
        "responses": { "200": { "description": "Connector health records", "content": { "application/json": { "schema": { "type": "object", "properties": { "services": { "type": "array", "items": { "$ref": "#/components/schemas/OpenAgriServiceHealth" } }, "weather_source": { "$ref": "#/components/schemas/WeatherSource" } } } } } } }
      }
    },
    "/api/openagri/core-services": {
      "get": {
        "summary": "Core OpenAgri services",
        "description": "Preferred endpoint for the core Gatekeeper, Weather Data, Irrigation Management and Pest & Disease Management service records.",
        "responses": {
          "200": {
            "description": "Core OpenAgri service health records",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "integration_group": { "type": "string", "example": "core" },
                    "core_service_basis": { "type": "boolean", "example": true },
                    "services": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/OpenAgriServiceHealth" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/openagri/services/test": {
      "post": {
        "summary": "Test one configured OpenAgri service connection",
        "parameters": [{ "name": "service", "in": "query", "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Connection test result", "content": { "application/json": { "schema": { "type": "object" } } } }, "404": { "description": "Unknown service" } }
      }
    },
    "/api/openagri/services/check-all": {
      "post": {
        "summary": "Check all configured OpenAgri service connections",
        "responses": {
          "200": {
            "description": "Connection test results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "services": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/OpenAgriServiceHealth" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/weather/current": {
      "get": {
        "summary": "External weather source and on-farm weather station readings",
        "responses": { "200": { "description": "Weather source and values", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WeatherStatus" } } } } }
      }
    },
    "/api/weather/configuration/status": {
      "get": {
        "summary": "Weather provider API key configuration status",
        "description": "Returns only safe metadata. The stored API key is never returned.",
        "responses": { "200": { "description": "Weather provider key status", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WeatherKeyStatusResponse" } } } } }
      }
    },
    "/api/weather/diagnostics": {
      "get": {
        "summary": "Weather service diagnostics",
        "responses": { "200": { "description": "Safe weather diagnostics without secret values", "content": { "application/json": { "schema": { "type": "object" } } } } }
      }
    },
    "/api/weather/api-key": {
      "post": {
        "summary": "Save or update Weather provider API key",
        "description": "Requires a settings-authorized session and CSRF token. The API key is write-only and is never returned.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WeatherApiKeyWrite" } } } },
        "responses": { "200": { "description": "API key saved" }, "403": { "description": "Settings permission required" }, "422": { "description": "Invalid API key" } }
      }
    },
    "/api/weather/api-key/validate": {
      "post": {
        "summary": "Validate stored Weather provider API key",
        "description": "Requires a settings-authorized session and CSRF token.",
        "responses": { "200": { "description": "Live observations available" }, "403": { "description": "Settings permission required" }, "422": { "description": "Validation failed" } }
      }
    },
    "/api/weather/api-key/remove": {
      "post": {
        "summary": "Remove stored Weather provider API key",
        "description": "Requires a settings-authorized session and CSRF token.",
        "responses": { "200": { "description": "API key removed" }, "403": { "description": "Settings permission required" } }
      }
    },
    "/api/analytics/summary": {
      "get": {
        "summary": "Analytics summary",
        "responses": { "200": { "description": "Operational analytics summary", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AnalyticsSummary" } } } } }
      }
    },
    "/api/analytics/weather": {
      "get": {
        "summary": "Weather analytics",
        "responses": { "200": { "description": "Weather statistics and source state", "content": { "application/json": { "schema": { "type": "object" } } } } }
      }
    },
    "/api/analytics/sensor-stations": {
      "get": {
        "summary": "Sensor station analytics",
        "responses": { "200": { "description": "Station comparison and sensor statistics", "content": { "application/json": { "schema": { "type": "object" } } } } }
      }
    },
    "/api/analytics/irrigation": {
      "get": {
        "summary": "Irrigation analytics",
        "responses": { "200": { "description": "Irrigation deficit, flow and energy statistics", "content": { "application/json": { "schema": { "type": "object" } } } } }
      }
    },
    "/api/analytics/pest-disease": {
      "get": {
        "summary": "Pest and disease analytics",
        "responses": { "200": { "description": "Risk and weather-input analytics", "content": { "application/json": { "schema": { "type": "object" } } } } }
      }
    },
    "/api/analytics/kpis": {
      "get": {
        "summary": "KPI analytics",
        "responses": { "200": { "description": "Operational KPI and performance records", "content": { "application/json": { "schema": { "type": "object" } } } } }
      }
    },
    "/api/analytics/service-freshness": {
      "get": {
        "summary": "OpenAgri service freshness analytics",
        "responses": { "200": { "description": "Service availability, freshness and latency records", "content": { "application/json": { "schema": { "type": "object" } } } } }
      }
    },
    "/api/sensor-stations": {
      "get": {
        "summary": "Sensor station inventory",
        "responses": { "200": { "description": "Station records", "content": { "application/json": { "schema": { "type": "object", "properties": { "stations": { "type": "array", "items": { "$ref": "#/components/schemas/SensorStation" } } } } } } } }
      }
    },
    "/api/sensors/readings": {
      "get": {
        "summary": "Flattened latest sensor readings",
        "responses": { "200": { "description": "Sensor readings", "content": { "application/json": { "schema": { "type": "object", "properties": { "readings": { "type": "array", "items": { "$ref": "#/components/schemas/SensorReading" } } } } } } } }
      }
    },
    "/api/irrigation/recommendations": {
      "get": {
        "summary": "Irrigation recommendation and source data",
        "responses": { "200": { "description": "Irrigation recommendation", "content": { "application/json": { "schema": { "type": "object" } } } } }
      }
    },
    "/api/pest-disease/alerts": {
      "get": {
        "summary": "Pest and disease alert",
        "responses": { "200": { "description": "Pest and disease alert", "content": { "application/json": { "schema": { "type": "object" } } } } }
      }
    },
    "/api/farm-calendar/operations": {
      "get": {
        "summary": "Farm operations",
        "responses": { "200": { "description": "Farm calendar operations", "content": { "application/json": { "schema": { "type": "object" } } } } }
      }
    },
    "/api/kpis": {
      "get": {
        "summary": "Operational KPI summary",
        "responses": { "200": { "description": "KPI records", "content": { "application/json": { "schema": { "type": "object" } } } } }
      }
    },
    "/api/reports/types": {
      "get": {
        "summary": "Report types",
        "description": "Returns the professional report types supported by AgriTwin.",
        "responses": { "200": { "description": "Report type list", "content": { "application/json": { "schema": { "type": "object" } } } } }
      }
    },
    "/api/reports": {
      "get": {
        "summary": "Generated reports",
        "description": "Lists locally generated PDF reports without exposing report payload internals. Requires an authenticated session.",
        "responses": { "200": { "description": "Generated report metadata", "content": { "application/json": { "schema": { "type": "object" } } } }, "401": { "description": "Unauthenticated" } }
      }
    },
    "/api/reports/generate": {
      "post": {
        "summary": "Generate PDF report",
        "description": "Generates a professional human-readable PDF report. JSON returned here is metadata only; the report deliverable is application/pdf. Requires an authenticated session.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "type": { "type": "string", "example": "field-operational" },
                  "lang": { "type": "string", "example": "en" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Generated report metadata", "content": { "application/json": { "schema": { "type": "object" } } } }, "401": { "description": "Unauthenticated" } }
      }
    },
    "/api/reports/download": {
      "get": {
        "summary": "Download generated PDF report",
        "parameters": [{ "name": "id", "in": "query", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Generated PDF report", "content": { "application/pdf": { "schema": { "type": "string", "format": "binary" } } } },
          "401": { "description": "Unauthenticated" },
          "404": { "description": "Report not found" }
        }
      }
    },
    "/api/users": {
      "get": {
        "summary": "List users for administrators",
        "description": "Requires an authenticated administrator session.",
        "responses": { "200": { "description": "User list", "content": { "application/json": { "schema": { "type": "object" } } } }, "403": { "description": "Administrator role required" } }
      }
    },
    "/api/help/sections": {
      "get": {
        "summary": "Help section metadata",
        "description": "Returns translated Help System section metadata for the selected language.",
        "parameters": [{ "name": "lang", "in": "query", "required": false, "schema": { "type": "string", "enum": ["en", "pt-PT", "es-ES"] } }],
        "responses": {
          "200": {
            "description": "Help section index",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "language": { "type": "string", "example": "en" },
                    "sections": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/HelpSection" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/edge/sensor-packets.php": {
      "post": {
        "summary": "Ingest edge sensor packet",
        "parameters": [{ "name": "Idempotency-Key", "in": "header", "required": false, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SensorPacket" } } } },
        "responses": { "202": { "description": "Packet accepted" }, "409": { "description": "Duplicate packet" }, "422": { "description": "Invalid packet" } }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthStatus": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "application": { "type": "string", "example": "AgriTwin" },
          "base_path": { "type": "string", "example": "/agritwin/" },
          "data_mode": { "type": "string", "example": "Local fallback active" }
        }
      },
      "OpenAgriServiceHealth": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "OpenAgri Weather Data Service" },
          "endpoint": { "type": "string" },
          "configured": { "type": "boolean" },
          "mode": { "type": "string", "enum": ["live", "auto", "fallback", "not_configured"] },
          "status": { "type": "string", "enum": ["live_healthy", "local_fallback_active", "degraded", "unavailable", "unauthenticated", "not_configured", "optional_not_configured"] },
          "core_service": { "type": "boolean", "example": true },
          "integration_priority": { "type": "string", "enum": ["core", "additional", "optional"] },
          "role": { "type": "string", "example": "Weather forecasts and agrometeorological indicators for DSS inputs." },
          "http_status": { "type": "integer", "nullable": true },
          "latency_ms": { "type": "integer", "nullable": true },
          "error_summary": { "type": "string" },
          "diagnostics": { "type": "string" }
        }
      },
      "SensorStation": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "MAC-ALM-A" },
          "name": { "type": "string", "example": "Station MAC-ALM-A" },
          "site": { "type": "string", "example": "Fotovoltaica Macotera SL" },
          "block": { "type": "string", "example": "Almond block A" },
          "crop": { "type": "string", "example": "Almonds" },
          "readings": { "type": "array", "items": { "$ref": "#/components/schemas/StationReading" } }
        }
      },
      "StationReading": {
        "type": "object",
        "properties": {
          "parameter": { "type": "string", "example": "soil_moisture" },
          "label": { "type": "string", "example": "Soil moisture" },
          "value": { "type": "number", "example": 28.4 },
          "unit": { "type": "string", "example": "% VWC" }
        }
      },
      "SensorReading": {
        "allOf": [
          { "$ref": "#/components/schemas/StationReading" },
          {
            "type": "object",
            "properties": {
              "id": { "type": "string", "example": "MAC-ALM-A-SOIL-MOISTURE" },
              "station_id": { "type": "string", "example": "MAC-ALM-A" },
              "timestamp": { "type": "string", "format": "date-time" },
              "confidence": { "type": "string", "example": "normal" }
            }
          }
        ]
      },
      "WeatherSource": {
        "type": "object",
        "properties": {
          "label": { "type": "string", "example": "External weather service: Open-Meteo public forecast" },
          "mode": { "type": "string", "example": "fallback" },
          "temperature_c": { "type": "number", "example": 13.8 },
          "humidity_pct": { "type": "integer", "example": 75 },
          "wind_kmh": { "type": "number", "example": 15.1 },
          "rainfall_mm": { "type": "number", "example": 0.2 }
        }
      },
      "WeatherStatus": {
        "type": "object",
        "properties": {
          "source": { "$ref": "#/components/schemas/WeatherSource" },
          "on_farm_station_readings": { "type": "array", "items": { "$ref": "#/components/schemas/SensorReading" } }
        }
      },
      "WeatherKeyStatusResponse": {
        "type": "object",
        "properties": {
          "weather_api_key": {
            "type": "object",
            "properties": {
              "configured": { "type": "boolean" },
              "source": { "type": "string", "enum": ["environment", "settings", "not_configured"] },
              "masked": { "type": "string", "nullable": true, "example": "************ABCD" },
              "last_updated_at": { "type": "string", "nullable": true },
              "last_validated_at": { "type": "string", "nullable": true },
              "last_validation_status": { "type": "string" }
            }
          }
        }
      },
      "WeatherApiKeyWrite": {
        "type": "object",
        "required": ["api_key"],
        "properties": {
          "api_key": { "type": "string", "writeOnly": true, "example": "REDACTED" },
          "transport": { "type": "string", "enum": ["bearer", "header", "query"], "example": "bearer" },
          "header_name": { "type": "string", "example": "X-API-Key" },
          "query_parameter_name": { "type": "string", "example": "api_key" }
        }
      },
      "AnalyticsSummary": {
        "type": "object",
        "properties": {
          "generated_at": { "type": "string", "format": "date-time" },
          "data_source": { "type": "string", "example": "Local operational dataset" },
          "location": { "type": "string", "example": "Macotera, Salamanca, Castilla y Leon, Spain" },
          "timezone": { "type": "string", "example": "Europe/Madrid" },
          "station_count": { "type": "integer", "example": 5 },
          "average_soil_moisture_pct": { "type": "number", "example": 26.42 },
          "latest_weather_source": { "type": "string", "example": "Open-Meteo public forecast" },
          "service_status_summary": { "type": "object" }
        }
      },
      "SensorPacket": {
        "type": "object",
        "required": ["gateway_id", "packet_id", "created_at", "measurements"],
        "properties": {
          "gateway_id": { "type": "string" },
          "packet_id": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "measurements": { "type": "array", "items": { "type": "object" } }
        }
      },
      "HelpSection": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "dashboard" },
          "title": { "type": "string", "example": "Dashboard" },
          "audience": { "type": "string", "example": "All users" },
          "administrator_access_required": { "type": "boolean", "example": false },
          "item_count": { "type": "integer", "example": 4 }
        }
      }
    }
  }
}
