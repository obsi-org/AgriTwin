# AgriTwin local development placeholders. Copy to .env locally if needed.
# Never commit real credentials, tokens, TLS material, raw pilot data, or farm network secrets.

AGRITWIN_DB_HOST=127.0.0.1
AGRITWIN_DB_PORT=33063
AGRITWIN_DB_NAME=agritwin_db
AGRITWIN_DB_USER=agritwin_app
AGRITWIN_DB_PASSWORD=replace-with-generated-local-password
AGRITWIN_DB_ROOT_PASSWORD=replace-with-generated-local-root-password
DB_HOST=127.0.0.1
DB_PORT=33063
DB_DATABASE=agritwin_db
DB_USERNAME=agritwin_app
DB_PASSWORD=replace-with-generated-local-password
AGRITWIN_ADMIN_PASSWORD_HASH=
AGRITWIN_APP_PORT=8083
AGRITWIN_BASE_PATH=/agritwin
APP_BASE_PATH=/agritwin
AGRITWIN_DB_PUBLISHED_PORT=33063
AGRITWIN_OPENAGRI_FIXTURE_PORT=18080
AGRITWIN_START_OPENAGRI=1
AGRITWIN_START_EXTERNAL_OPENAGRI=0

OPENAGRI_MODE=auto
OPENAGRI_GATEKEEPER_URL=http://host.docker.internal:18091
OPENAGRI_GATEKEEPER_HEALTH_URL=/health
OPENAGRI_GATEKEEPER_DOCS_URL=http://host.docker.internal:18091/docs
OPENAGRI_GATEKEEPER_CLIENT_ID=replace-with-openagri-client-id
OPENAGRI_GATEKEEPER_CLIENT_SECRET=replace-with-openagri-client-secret
OPENAGRI_GATEKEEPER_TOKEN_URL=
OPENAGRI_WEATHER_URL=http://host.docker.internal:18092
OPENAGRI_WEATHER_HEALTH_URL=/docs
OPENAGRI_WEATHER_DOCS_URL=http://host.docker.internal:18092/docs
OPENAGRI_WEATHER_DATA_URL=/api/data/weather/?lat=40.9492&lon=-5.6958
OPENAGRI_IRRIGATION_URL=http://host.docker.internal:18093
OPENAGRI_IRRIGATION_HEALTH_URL=/api/irrigation/advisory
OPENAGRI_IRRIGATION_DOCS_URL=http://host.docker.internal:18093/docs
OPENAGRI_PEST_DISEASE_URL=http://host.docker.internal:18094
OPENAGRI_PEST_DISEASE_HEALTH_URL=/api/pest/risk
OPENAGRI_PEST_DISEASE_DOCS_URL=http://host.docker.internal:18094/docs
OPENAGRI_FARMCALENDAR_URL=http://host.docker.internal:18095
OPENAGRI_FARMCALENDAR_HEALTH_URL=/api/calendar/operations
OPENAGRI_FARMCALENDAR_DOCS_URL=http://host.docker.internal:18095/docs
OPENAGRI_REPORTING_URL=http://host.docker.internal:18096
OPENAGRI_REPORTING_HEALTH_URL=/api/reports
OPENAGRI_REPORTING_DOCS_URL=http://host.docker.internal:18096/docs
OPENAGRI_GEODATABASE_URL=http://host.docker.internal:18097
OPENAGRI_GEODATABASE_HEALTH_URL=/health
OPENAGRI_GEODATABASE_DOCS_URL=http://host.docker.internal:18097/docs
AGRITWIN_WEATHER_SOURCE_PREFERENCE=auto

AGRITWIN_OPENAGRI_MODE=auto
AGRITWIN_OPENAGRI_CACHE_ENABLED=true
AGRITWIN_OPENAGRI_OFFLINE_MODE=false
AGRITWIN_OPENAGRI_TIMEOUT_SECONDS=10
AGRITWIN_OPENAGRI_RETRIES=2
AGRITWIN_OPENAGRI_BACKOFF_MS=250
AGRITWIN_OPENAGRI_CACHE_DIR=var/cache/openagri
AGRITWIN_OPENAGRI_QUEUE_DIR=var/queue/openagri
AGRITWIN_OPENAGRI_RESTORE_WINDOW_SECONDS=259200
AGRITWIN_OPENAGRI_LOG_ENABLED=true

AGRITWIN_OPENAGRI_GATEKEEPER_URL=http://host.docker.internal:18091
AGRITWIN_OPENAGRI_GATEKEEPER_USERNAME=replace-with-gatekeeper-user
AGRITWIN_OPENAGRI_GATEKEEPER_PASSWORD=replace-with-gatekeeper-password
AGRITWIN_OPENAGRI_GATEKEEPER_ACCESS_TOKEN=

AGRITWIN_OPENAGRI_WEATHER_URL=http://host.docker.internal:18092
AGRITWIN_OPENAGRI_WEATHER_TOKEN=
AGRITWIN_OPENAGRI_WEATHER_TTL_SECONDS=21600

AGRITWIN_OPENAGRI_IRRIGATION_URL=http://host.docker.internal:18093
AGRITWIN_OPENAGRI_IRRIGATION_TOKEN=
AGRITWIN_OPENAGRI_IRRIGATION_TTL_SECONDS=86400

AGRITWIN_OPENAGRI_PEST_DISEASE_URL=http://host.docker.internal:18094
AGRITWIN_OPENAGRI_PEST_DISEASE_TOKEN=
AGRITWIN_OPENAGRI_PEST_DISEASE_TTL_SECONDS=86400

AGRITWIN_OPENAGRI_FARMCALENDAR_URL=http://host.docker.internal:18095
AGRITWIN_OPENAGRI_FARMCALENDAR_TOKEN=
AGRITWIN_OPENAGRI_FARMCALENDAR_TTL_SECONDS=900

AGRITWIN_OPENAGRI_REPORTING_URL=http://host.docker.internal:18096
AGRITWIN_OPENAGRI_REPORTING_TOKEN=
AGRITWIN_OPENAGRI_REPORTING_TTL_SECONDS=0

AGRITWIN_KPI_STORE=var/kpi/events.jsonl
AGRITWIN_KPI_EXPORT_DIR=exports/kpi
AGRITWIN_KPI_EVIDENCE_DIR=docs/evidence/generated

AGRITWIN_EDGE_GATEWAY_ID=edge-local-001
AGRITWIN_EDGE_QUEUE_DIR=var/edge/queue
AGRITWIN_EDGE_CACHE_DIR=var/edge/cache
AGRITWIN_EDGE_SAMPLING_INTERVAL_MINUTES=15
AGRITWIN_EDGE_TIMEOUT_SECONDS=10
AGRITWIN_EDGE_MAX_RETRIES=3
AGRITWIN_EDGE_BACKOFF_SECONDS=30
AGRITWIN_EDGE_OPENAGRI_STALE_SECONDS=21600
AGRITWIN_EDGE_FORCE_OFFLINE=false
AGRITWIN_CLOUD_DSS_URL=http://localhost:8083
AGRITWIN_CLOUD_DSS_TOKEN=

AGRITWIN_CESIUM_TOKEN=replace-with-local-token
AGRITWIN_COPERNICUS_ID=replace-with-local-project-id
AGRITWIN_AEMET_API_KEY=replace-with-local-aemet-key
