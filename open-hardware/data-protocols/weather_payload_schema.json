{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agritwin.example/schemas/open-hardware/weather-payload.schema.json",
  "title": "AgriTwin weather station payload",
  "type": "object",
  "required": [
    "deployment_id",
    "station_id",
    "observed_at",
    "data_source_classification",
    "readings",
    "units",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "deployment_id": {
      "type": "string",
      "pattern": "^[a-z0-9_\\-]{3,64}$"
    },
    "station_id": {
      "type": "string",
      "pattern": "^[a-z0-9_\\-]{3,64}$"
    },
    "observed_at": {
      "type": "string",
      "description": "ISO-8601 timestamp or gateway_timestamp when assigned by edge/cloud ingestion."
    },
    "data_source_classification": {
      "type": "string",
      "enum": [
        "field_weather_station",
        "edge_buffered_weather_station",
        "synthetic_developer_sample"
      ]
    },
    "readings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "air_temperature_c": {
          "type": "number",
          "minimum": -30,
          "maximum": 60
        },
        "relative_humidity_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "rainfall_mm": {
          "type": "number",
          "minimum": 0,
          "maximum": 250
        },
        "wind_speed_kmh": {
          "type": "number",
          "minimum": 0,
          "maximum": 180
        },
        "wind_direction_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        },
        "solar_radiation_w_m2": {
          "type": "number",
          "minimum": 0,
          "maximum": 1400
        },
        "atmospheric_pressure_hpa": {
          "type": "number",
          "minimum": 800,
          "maximum": 1100
        },
        "battery_voltage_v": {
          "type": "number",
          "minimum": 0,
          "maximum": 30
        }
      },
      "minProperties": 1
    },
    "units": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "status": {
      "type": "object",
      "required": [
        "battery",
        "clock"
      ],
      "additionalProperties": true,
      "properties": {
        "battery": {
          "type": "string",
          "enum": [
            "normal",
            "low",
            "critical",
            "unknown"
          ]
        },
        "clock": {
          "type": "string",
          "enum": [
            "synchronised",
            "gateway_assigned",
            "unsynchronised"
          ]
        },
        "quality": {
          "type": "string",
          "enum": [
            "normal",
            "reduced",
            "invalid"
          ]
        }
      }
    }
  }
}
