{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agritwin.example/schemas/open-hardware/sensor-payload.schema.json",
  "title": "AgriTwin standard sensor node payload",
  "type": "object",
  "required": [
    "deployment_id",
    "node_id",
    "observed_at",
    "data_source_classification",
    "readings",
    "units",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "deployment_id": {
      "type": "string",
      "pattern": "^[a-z0-9_\\-]{3,64}$"
    },
    "node_id": {
      "type": "string",
      "pattern": "^[a-z0-9_\\-]{3,64}$"
    },
    "observed_at": {
      "type": "string",
      "description": "ISO-8601 timestamp or gateway_timestamp when assigned by edge/cloud ingestion."
    },
    "data_source_classification": {
      "type": "string",
      "enum": [
        "field_sensor_node",
        "edge_buffered_sensor_node",
        "synthetic_developer_sample"
      ]
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "location_precision": {
          "type": "string",
          "enum": [
            "none",
            "regional_or_grid_cell",
            "synthetic_coarse"
          ]
        },
        "coordinate_type": {
          "type": "string",
          "enum": [
            "not_provided",
            "synthetic",
            "coarse_grid"
          ]
        }
      }
    },
    "readings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "soil_moisture_vwc_pct_a": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "soil_moisture_vwc_pct_b": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "soil_temperature_c": {
          "type": "number",
          "minimum": -10,
          "maximum": 60
        },
        "air_temperature_c": {
          "type": "number",
          "minimum": -20,
          "maximum": 60
        },
        "relative_humidity_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "leaf_wetness_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "battery_voltage_v": {
          "type": "number",
          "minimum": 0,
          "maximum": 30
        }
      },
      "minProperties": 1
    },
    "units": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "status": {
      "type": "object",
      "required": [
        "battery",
        "clock"
      ],
      "additionalProperties": true,
      "properties": {
        "battery": {
          "type": "string",
          "enum": [
            "normal",
            "low",
            "critical",
            "unknown"
          ]
        },
        "clock": {
          "type": "string",
          "enum": [
            "synchronised",
            "gateway_assigned",
            "unsynchronised"
          ]
        },
        "quality": {
          "type": "string",
          "enum": [
            "normal",
            "reduced",
            "invalid"
          ]
        }
      }
    }
  }
}
